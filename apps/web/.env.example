# 全局系统品牌配置
#
# 控制全站应用品牌名称、短名称与描述等。统一由 `apps/web/src/lib/brand.ts`
# 的受控函数 `getBrandConfig()` / `useBrand()` 读取，禁止在业务组件或页面中硬编码。
#   VITE_APP_NAME="Nivo Admin"            # 系统品牌全称（缺省 Nivo Admin，用于网页标题、关于页等）
#   VITE_APP_SHORT_NAME="Admin"           # 系统品牌简称（缺省 Admin，用于紧凑侧边栏等）
#   VITE_APP_DESCRIPTION="多应用工作空间的后端管理台" # 品牌简要描述
#
# OAuth 第三方社交登录配置（全部可选，默认关闭）
#
# 支持 Google、GitHub、Apple 等第三方登录与注册，回调路径统一由 /oauth/:provider/callback 处理。
# 若需启用对应平台，置为 true 即可：
VITE_OAUTH_GOOGLE_ENABLED=false
VITE_OAUTH_GITHUB_ENABLED=false
VITE_OAUTH_APPLE_ENABLED=false
#
# API 请求基础地址
#
# 默认指向仓库内置的 Mock API（见 apps/mock/README.md），clone 后无需任何后端即可跑通。
# 注意：契约里每个接口的 path 都是完整的（/login、/user…），所以这里**不要**再加 /api 后缀。
# 连接真实后端时，在 .env.local 里覆盖这一项，例如：
#   VITE_API_BASE_URL=https://your-api.example.com
VITE_API_BASE_URL=http://localhost:3001

# ── 部署模式（应用维度 × 账号维度） ──────────────────────────────────────────
#
# 这一份前端产物靠**两个互相独立的环境变量**适配四种部署形态，不需要改代码：
#
#                     │ 单账号 (VITE_MULTI_ACCOUNT=false) │ 多账号 (默认)
#   ──────────────────┼───────────────────────────────────┼─────────────────────────
#   单应用 (默认)     │ 内部管理台：一个应用、一个账号      │ 小型 SaaS：单应用 + 注册
#   多应用 MULTI_APP  │ 平台内多工作空间、账号由管理员开    │ 完整 SaaS：注册 + 多应用
#
# 读取入口只有 `apps/web/src/lib/app-config.ts` 的受控函数
# （isMultiAppEnabled / isMultiAccountEnabled / getAppSelectMode / getAuthUiOptions …），
# 页面与组件一律调它们，**不要在别处再读一遍 import.meta.env**。
#
# 应用维度：
#   VITE_MULTI_APP=false          # 单应用：无选择页、无切换器，直接进默认应用（缺省 false）
#   VITE_MULTI_APP=true           # 多应用：登录后按下方策略决定是否进 `/` 应用选择页
#   VITE_DEFAULT_APP_ID=nivo      # 单应用模式下的默认应用 ID（路由前缀与存储作用域，缺省 nivo）
#   VITE_DEFAULT_APP_NAME=Admin   # 单应用模式下的默认应用展示名称（缺省取品牌简称）
#   VITE_APP_SELECT_MODE=auto     # 多应用下何时进选择页：auto | always | never（缺省 auto）
#                                 #   auto   —— 可用应用 > 1 才进（只有一个就没必要选）
#                                 #   always —— 每次都进（把选择页当作应用门户）
#                                 #   never  —— 从不进，直接落到首个可用应用
#
# 账号维度：
#   VITE_MULTI_ACCOUNT=true       # 多账号：开放注册 / 找回入口（缺省 true）
#   VITE_MULTI_ACCOUNT=false      # 单账号：/auth/register 等路由直接弹回登录，登录页隐藏注册与找回链接
#   VITE_SHOW_DEMO_ACCOUNTS=true  # 登录页是否渲染「测试账号」下拉；缺省跟随 DEV（开发开、构建关）
#   VITE_SUPER_ADMIN_ID=          # 最高管理员账号标识（uid 或 username，大小写不敏感，缺省空）
#                                 # 命中者在**前端**被当作超管（用于显示应用管理等入口）；
#                                 # 真正的权限边界在后端接口 —— 见下方「权限说明」
VITE_MULTI_APP=false
VITE_MULTI_ACCOUNT=true

# ── 权限说明（重要） ────────────────────────────────────────────────────────
#
# 前端**不是**安全边界：
#   · 权限点来自 `GET /permissions`（如 `app:read`），由后端按账号下发；
#   · 通用权限组件 `#/components/permission-guard` 的 `<Can>` / `<PermissionButton>`
#     只决定「显不显示、能不能点」—— 目的是给用户干净的界面，不是拦截；
#   · 所有写接口都假定后端已做鉴权（mock 里对超管接口回 403 就是这个约定）。
# 因此：新增一个受控操作 = 后端加鉴权 + 前端用 <Can> 收敛入口，两者缺一不可。

# AI 中间层地址（apps/ai 的 Hono Worker）
#
# 前端**只**连这一个地址：系统提示词与模型凭证都在服务端（见 .agents/docs/ai-server-layer.md）。
# 本地默认：pnpm -C apps/ai dev（端口 3002）。
# 生产：填部署后的 Worker 域名，并把该域名加入 Worker 的 ALLOWED_ORIGINS。
#   VITE_AI_SERVICE_BASE_URL=https://ai.example.com
VITE_AI_SERVICE_BASE_URL=http://localhost:3002

# ── 局域网访问（手机 / 别的机器打开前端） ────────────────────────────────────
#
# 三个 dev server 默认都监听所有网卡，同一局域网内直接用 `http://<本机 IP>:3000`
# 打开页面即可：
#   · web  —— vite.config.ts 的 `server.host`（0.0.0.0，端口在 package.json）
#   · mock —— nitro.config.ts 的 `devServer.hostname`（0.0.0.0:3001）
#   · ai   —— wrangler.toml 的 `[dev].ip`（0.0.0.0:3002）
#
# 但**接口地址也得是同一个局域网 IP**：别的设备上的 `localhost` 指向它自己。
# 在 `apps/web/.env.development.local` 里覆盖（只对 `pnpm dev` 生效，已被 git 忽略）：
#   VITE_API_BASE_URL=http://<本机 IP>:3001
#   VITE_AI_SERVICE_BASE_URL=http://<本机 IP>:3002
# 再把 `http://<本机 IP>:3000` 加进 apps/ai/wrangler.toml 的 `ALLOWED_ORIGINS`，
# 否则 AI 请求会在预检阶段被拒（mock 会回显任意来源，不受影响）。
#
# 注意：用**主机名**访问时还要把主机名加进 vite.config.ts 的 `server.allowedHosts`；
# 直接访问 IP 无需任何额外配置。
#
# `pnpm build` 不读 `.env.development.local`：要让构建产物也走局域网，构建时覆盖即可，
#   VITE_API_BASE_URL=http://<本机 IP>:3001 pnpm build
