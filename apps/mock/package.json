{
  "name": "@admin/mock",
  "private": true,
  "type": "module",
  "description": "契约自持的 Mock API（Nitro v3）：接口定义与 OpenAPI 契约同源，契约由路由反向生成。",
  "scripts": {
    "dev": "nitro dev --port 3001",
    "build": "nitro build",
    "build:cloudflare": "nitro build --preset cloudflare_module",
    "build:vercel": "nitro build --preset vercel",
    "preview": "node .output/server/index.mjs",
    "deploy": "nitro deploy --prebuilt"
  },
  "devDependencies": {
    "nitro": "3.0.260903-beta"
  }
}
