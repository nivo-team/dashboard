{
  "name": "admin-console",
  "version": "0.1.0",
  "private": true,
  "description": "多应用后台管理模板：契约自持的前端 + Nitro Mock API。",
  "type": "module",
  "scripts": {
    "dev": "pnpm -C apps/web dev",
    "dev:all": "vp run --parallel --filter './apps/*' dev",
    "build": "pnpm -C apps/web build",
    "preview": "pnpm -C apps/web preview",
    "typecheck": "pnpm -C apps/web typecheck",
    "mock": "pnpm -C apps/mock dev",
    "mock:build": "pnpm -C apps/mock build",
    "ai": "pnpm -C apps/ai dev",
    "ai:deploy": "pnpm -C apps/ai deploy",
    "contract": "node packages/api-client/scripts/sync.mjs",
    "api": "pnpm contract && pnpm -C packages/api-client api",
    "guardrails": "node scripts/ai/check-guardrails.mjs",
    "i18n:types": "node scripts/i18n/gen-types.mjs",
    "i18n:check-keys": "node scripts/i18n/check-keys.mjs",
    "i18n:check": "node scripts/i18n/check-keys.mjs --strict && node scripts/i18n/translate.mjs --check && node scripts/i18n/gen-types.mjs --check",
    "i18n:dry": "node scripts/i18n/translate.mjs --dry --stats",
    "i18n": "node scripts/i18n/translate.mjs"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.7.0"
}
