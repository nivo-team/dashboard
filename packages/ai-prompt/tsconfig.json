{
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "types": [],

    /* Bundler mode（与 apps/web 对齐） */
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    /* 包内 import 显式带 `.ts` 扩展名：这样 node 能直接运行/测试本包（见 README）。 */
    "allowImportingTsExtensions": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
